# Local development overrides. Copy to .env.local (git-ignored) and adjust.
# Without these the app targets the deployed production services.

# Point at the local API from ../dev-env.sh instead of production
VITE_API_BASE_URL=http://localhost:5055/api

# Point at the local message relay instead of production
VITE_RELAY_URL=http://localhost:5056/api/messages
